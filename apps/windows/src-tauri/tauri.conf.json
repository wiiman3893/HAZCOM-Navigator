{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HazCom Navigator",
  "version": "0.1.0",
  "identifier": "com.saturnstraw.hazcomnavigator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HazCom Navigator",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:hazcom-navigator.db"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
