{
  "name": "hazcom-navigator",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "firebase/functions"
  ],
  "scripts": {
    "build:core": "npm run build -w @hazcom/core",
    "test:core": "npm run test -w @hazcom/core",
    "dev:windows": "npm run dev -w @hazcom/windows",
    "dev:mobile": "npm run dev -w @hazcom/mobile",
    "build": "npm run build:core && npm run build -w @hazcom/windows && npm run build -w @hazcom/mobile",
    "test": "npm run test:core && npm run test:sqlite",
    "test:sqlite": "node scripts/validate-sqlite.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
