rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function allowed(companyId,revisionId,attachmentId,digest) {
      let member = firestore.get(/databases/(default)/documents/companies/$(companyId)/memberships/$(request.auth.uid)).data;
      let attachment = firestore.get(/databases/(default)/documents/companies/$(companyId)/publishedRevisions/$(revisionId)/attachments/$(attachmentId)).data;
      // Storage permits at most two Firestore document lookups. published is set only
      // in the atomic revision-finalization transaction. Membership removal revokes access.
      return member.active == true && member.role in ['administrator','manager','member']
        && attachment.published == true && digest == attachment.sha256 + '.pdf';
    }
    match /companies/{companyId}/revisions/{revisionId}/sds/{attachmentId}/{digest} {
      allow get: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous' && allowed(companyId,revisionId,attachmentId,digest);
      // Includes Manager/Admin: uploads must pass trusted Function role and entitlement checks.
      allow list, write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
